<%= link_to skill_path(skill), class: "card skill-card", data: { filter_target: "item", search: skill.title.to_s.downcase, filter: skill.discipline&.name } do %>
  <% if skill.discipline %>
    <div class="card-discipline"><%= skill.discipline.name %></div>
  <% end %>
  <h3 class="card-title"><%= skill.title %></h3>
  <% if skill.description %>
    <p class="card-description"><%= skill.description %></p>
  <% end %>
  <div class="card-meta">
    <span class="home-section-link">
      View skill <%= icon("arrow-right", size: 14) %>
    </span>
  </div>
<% end %>
