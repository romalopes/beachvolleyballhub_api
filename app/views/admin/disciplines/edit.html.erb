<div class="page">
  <div class="page-header">
    <h1>Edit Discipline</h1>
    <p>Update this discipline's information.</p>
    <div class="page-header-actions">
      <%= link_to admin_discipline_path(@discipline), class: "admin-btn" do %>
        <%= icon("arrow-left", size: 16) %> Back to Discipline
      <% end %>
    </div>
  </div>

  <div style="max-width: 600px;">
    <%= render "admin/disciplines/form", discipline: @discipline %>
  </div>
</div>
