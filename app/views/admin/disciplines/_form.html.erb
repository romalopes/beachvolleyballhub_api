<%= form_with model: @discipline, url: @discipline.new_record? ? admin_disciplines_path : admin_discipline_path(@discipline),
    class: "admin-form", local: true do |form| %>
  <% if @discipline.errors.any? %>
    <div class="auth-flash auth-flash-error">
      <h4 style="margin-bottom: 0.5rem;"><%= pluralize(@discipline.errors.count, "error") %> prevented this discipline from being saved:</h4>
      <ul style="margin: 0; padding-left: 1.5rem;">
        <% @discipline.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-form-section">
    <h3>Basic Information</h3>

    <div class="admin-field">
      <%= form.label :name, "Name", required: true %>
      <%= form.text_field :name, class: "admin-input", placeholder: "e.g. Attack", maxlength: 255 %>
    </div>
  </div>

  <div class="admin-form-actions">
    <%= link_to @discipline.new_record? ? admin_disciplines_path : admin_discipline_path(@discipline), class: "admin-btn" do %>
      <%= icon("arrow-left", size: 16) %> Back
    <% end %>
    <%= form.submit @discipline.new_record? ? "Create Discipline" : "Update Discipline", class: "admin-btn admin-btn-add" %>
  </div>
<% end %>
