<div class="page">
  <div class="page-header">
    <h1>New Discipline</h1>
    <p>Add a new discipline to the system.</p>
    <div class="page-header-actions">
      <%= link_to admin_disciplines_path, class: "admin-btn" do %>
        <%= icon("arrow-left", size: 16) %> Back to Disciplines
      <% end %>
    </div>
  </div>

  <div style="max-width: 600px;">
    <%= render "admin/disciplines/form", discipline: @discipline %>
  </div>
</div>
