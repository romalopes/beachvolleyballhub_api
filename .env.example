# Explicitly select brevo, resend, smtp, file, or leave as auto.
MAIL_TRANSPORT=file
MAIL_FROM="BVB Project <no-reply@example.com>"
MAIL_REPLY_TO=support@example.com
APP_HOST=localhost
FRONTEND_URL=http://localhost:5174
# Comma-separated browser origins accepted by the API. The production apex
# domain is always allowed; set this for other intentional clients/previews.
# CORS_ORIGINS=https://beachvolleyballhub.com,https://beachvolleyballhub.romalopes.workers.dev
# Comma-separated hostnames allowed by Rails Host Authorization in production.
ALLOWED_HOSTS=localhost

# IP2Location API key for geolocating login IPs in new-login notification emails.
# Optional: when absent, the Location field degrades to "Unknown" and no
# network call is made. Get a free key at https://ip2location.io
IP2LOCATION_API_KEY=

# Asynchronous venue address geocoding. Geoapify is the initial provider;
# proposals still save when this is disabled or no API key is configured.
GEOCODING_ENABLED=false
GEOCODING_PROVIDER=geoapify
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=
GEOCODING_USER_AGENT=
GEOCODING_OPEN_TIMEOUT=3
GEOCODING_READ_TIMEOUT=5

BREVO_API_KEY=
RESEND_API_KEY=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS=true
