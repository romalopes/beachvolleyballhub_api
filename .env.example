# Explicitly select brevo, resend, smtp, file, or leave as auto.
MAIL_TRANSPORT=file
MAIL_FROM="BVB Project <no-reply@example.com>"
MAIL_REPLY_TO=support@example.com
APP_HOST=localhost
FRONTEND_URL=http://localhost:5174
# Comma-separated browser origins accepted by the API. The production apex
# domain is always allowed; set this for other intentional clients/previews.
# CORS_ORIGINS=https://beachvolleyballhub.com,https://beachvolleyballhub.romalopes.workers.dev
# Comma-separated hostnames allowed by Rails Host Authorization in production.
ALLOWED_HOSTS=localhost

# IP2Location API key for geolocating login IPs in new-login notification emails.
# Optional: when absent, the Location field degrades to "Unknown" and no
# network call is made. Get a free key at https://ip2location.io
IP2LOCATION_API_KEY=

# Asynchronous venue address geocoding. Geoapify is the initial provider;
# proposals still save when this is disabled or no API key is configured.
GEOCODING_ENABLED=false
GEOCODING_PROVIDER=geoapify
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=
GEOCODING_USER_AGENT=
GEOCODING_OPEN_TIMEOUT=3
GEOCODING_READ_TIMEOUT=5

BREVO_API_KEY=
RESEND_API_KEY=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS=true
# Weather API key for WeatherAPI.com (free tier)
# Set this in Render secrets for production, and in local .env file for development
# WEATHERAPI_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Public contact form (IDENTITY-259)
# ---------------------------------------------------------------------------
# Comma-separated addresses that receive a notification for each public contact
# form submission. This is a RECIPIENT list, deliberately separate from
# MAIL_REPLY_TO (a Reply-To header that keeps its application-wide meaning).
# Invalid entries are ignored and logged; an empty value means "nobody to email"
# (the message is still stored and visible in Settings -> Contact Messages).
CONTACT_NOTIFICATION_EMAILS=

# Cloudflare Turnstile server-side secret used to verify submissions against
# Siteverify. Leave empty in development/test (verification is then disabled);
# production FAILS CLOSED when it is missing, so the contact form would reject
# every submission until this is set. Never commit the real value.
TURNSTILE_SECRET_KEY=

# Optional: comma-separated hostnames accepted in the Siteverify response
# (e.g. beachvolleyballhub.com,www.beachvolleyballhub.com). Leave empty to skip
# the hostname check; the Turnstile widget's configured hostnames are the first
# line of defence.
TURNSTILE_EXPECTED_HOSTNAME=

# Optional per-IP limits for POST /api/v1/contact_messages, enforced by
# Rack::Attack. Defaults: 5 per 10 minutes and 20 per day. Raise them if a club
# or venue shares one NAT address.
# CONTACT_RATE_LIMIT_PER_10_MINUTES=5
# CONTACT_RATE_LIMIT_PER_DAY=20
